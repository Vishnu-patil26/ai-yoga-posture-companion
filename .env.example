# Copy this file to ".env" and paste your own free Groq key after the equals sign.
# Get one at https://console.groq.com/keys (sign in, "Create API Key").
# ".env" is git-ignored and never leaves your machine. Without a key the app still
# works; the coach's sentences just use the built-in templates.
GROQ_API_KEY=

# Optional:
# YOGA_LLM=off                       # keep everything offline even with a key
# YOGA_GROQ_MODEL=openai/gpt-oss-20b
